{% extends "page.html.twig" %}

{% block content %}
    <form action="{% if event.getId() %}{{ url_for("events_storeevent_edit", {"id": event.getId()}) }}{% else %}{{ url_for("events_storeevent_add") }}{% endif %}" method="post" class="ui form">
        <div class="ui styled fluid accordion field">
            <div class="active title">
                <i class="icon dropdown" aria-hidden="true"></i>
                {{ _T("General information", "events") }}
            </div>
            <div class="active content">
                {% include "components/forms/checkbox.html.twig" with {
                    id: 'open',
                    value: 1,
                    label: _T("Is open", "events"),
                    checked: event.isOpenFlag()
                } %}

                {% include "components/forms/text.html.twig" with {
                    id: 'name',
                    value: event.getName(),
                    label: _T("Name", "events"),
                    required: true,
                } %}

                {% include "components/forms/input.html.twig" with {
                    id: 'color',
                    value: event.getColor(),
                    label: _T("Color", "events"),
                    type: 'color'
                } %}

                {% include "components/forms/date.html.twig" with {
                    id: 'begin_date',
                    value: event.getBeginDate()|date(_T("Y-m-d")),
                    label: _T("Begin date", "events"),
                } %}

                {% include "components/forms/date.html.twig" with {
                    id: 'end_date',
                    value: event.getEndDate()|date(_T("Y-m-d")),
                    label: _T("End date", "events"),
                } %}

                {% set group_list_values = {(0): _T("Select a group")} %}
                {% for group in groups %}
                    {% set group_list_values = group_list_values + {(group.getId()): group.getIndentName()} %}
                {% endfor %}

                {% include "components/forms/select.html.twig" with {
                    id: 'group',
                    value: event.getGroup(),
                    values: group_list_values,
                    label: _T("Limit to group", "events"),
                    title: _T("Restrict event to selected group (and its subgroups).", "events"),
                    raw_labels: true
                } %}

                {% include "components/forms/textarea.html.twig" with {
                    id: 'comment',
                    value: event.getComment(),
                    label: _T("Comment", "events"),
                } %}
            </div>
        </div>

        <div class="ui styled fluid accordion field">
            <div class="active title">
                <i class="icon dropdown" aria-hidden="true"></i>
                {{ _T("Location", "events") }}
            </div>
            <div class="active content">
                {% include "components/forms/text.html.twig" with {
                    id: 'address',
                    value: event.getAddress(),
                    label: _T("Address", "events"),
                } %}

                {% include "components/forms/text.html.twig" with {
                    id: 'zip',
                    value: event.getZip(),
                    label: _T("Zip code", "events"),
                } %}

                {% include "components/forms/text.html.twig" with {
                    id: 'town',
                    value: event.getTown(),
                    label: _T("Town", "events"),
                    required: true,
                } %}

                {% include "components/forms/text.html.twig" with {
                    id: 'country',
                    value: event.getCountry(),
                    label: _T("Country", "events"),
                } %}
            </div>
        </div>

        <div class="ui styled fluid accordion field">
            <div class="active title">
                <i class="icon dropdown" aria-hidden="true"></i>
                {{ _T("Activities", "events") }}
            </div>
            <div class="active content">
    {% set availables = event.availableActivities() %}
    {% set activities = event.getActivities() %}
    {% if availables|length or activities|length %}
        {% if availables|length %}
            {% set attach_values = {'': _T("Choose an activity to add", "events")} %}
            {% for activity in availables %}
                {% set attach_values = attach_values + {(activity.id_activity): activity.name} %}
            {% endfor %}
                <div class="fields">
                    {% include "components/forms/select.html.twig" with {
                        id: 'attach_activity',
                        value: '',
                        values: attach_values,
                        label: _T("Add selected activity to event", "events"),
                        component_class: 'twelve wide field'
                    } %}
                    <div class="four wide field flexend">
                        <button type="submit" name="add_activity" id="add_activity" class="action ui labeled icon button" aria-controls="attach_activity" data-message="{{ _T("Please choose an activity to add", "events") }}" data-close="{{ _T("Close") }}">
                            <i class="add icon" aria-hidden="true"></i>
                            {{ _T("Add") }}
                        </button>
                    </div>
                </div>
        {% endif %}
        {% if activities|length %}
            {% set detach_values = {'': _T("Choose an activity to remove", "events")} %}
            {% for item in activities %}
                {% set detach_values = detach_values + {(item.activity.getId()): item.activity.getName()} %}
            {% endfor %}
                <div class="fields">
                    {% include "components/forms/select.html.twig" with {
                        id: 'detach_activity',
                        value: '',
                        values: detach_values,
                        label: _T("Remove selected activity from event", "events"),
                        component_class: 'twelve wide field'
                    } %}
                    <div class="four wide field flexend">
                        <button type="submit" name="remove_activity" id="remove_activity" class="action ui labeled icon button" aria-controls="detach_activity" data-message="{{ _T("Please choose an activity to remove", "events") }}" data-close="{{ _T("Close") }}">
                            <i class="delete red icon" aria-hidden="true"></i>
                            {{ _T("Remove") }}
                        </button>
                    </div>
                </div>

            {% set status_values = {
                (constant('GaletteEvents\\Activity::YES')): _T("Yes"),
                (constant('GaletteEvents\\Activity::NO')): _T("No"),
                (constant('GaletteEvents\\Activity::REQUIRED')): _T("Required", "events")
            } %}
            {% for item in activities %}
                <input type="hidden" name="activities_ids[]" value="{{ item.activity.getId() }}"/>
                {% include "components/forms/select.html.twig" with {
                    id: 'activities_status_' ~ item.activity.getId(),
                    name: 'activities_status[]',
                    value: item.status,
                    values: status_values,
                    label: item.activity.getName()
                } %}
            {% endfor %}
        {% endif %}
    {% else %}
                <p>{{ _T("No activity available in the database.", "events") }}</p>
    {% endif %}
            </div>
        </div>

        <div class="ui basic center aligned fitted segment">
            <button type="submit" name="save" class="action ui labeled icon primary button">
                <i class="save icon" aria-hidden="true"></i> {{ _T("Save") }}
            </button>
            <input type="hidden" name="id" id="id" value="{{ event.getId() }}"/>
        </div>
     </form>
{% endblock %}
