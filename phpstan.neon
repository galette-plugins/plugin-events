parameters:
    parallel:
        maximumNumberOfProcesses: 2
    level: 6
    paths:
        - lib/
        - tests/
    scanFiles:
        - _config.inc.php
        - ../../includes/sys_config/paths.inc.php
        - ../../config/config.inc.php.dist
    scanDirectories:
        - ../../includes/
        - ../../lib/
    universalObjectCratesClasses:
        - RKA\Session
